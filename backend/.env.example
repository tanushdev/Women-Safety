# Backend Environment Variables

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
MONGODB_URI=mongodb://localhost:27017/women-safety
MONGODB_TEST_URI=mongodb://localhost:27017/women-safety-test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Configuration
OTP_SECRET=your-otp-secret-key-change-in-production
OTP_EXPIRES_IN=300

# AWS S3 (or compatible storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=women-safety-media
AWS_S3_ENDPOINT=
# For local development with MinIO:
# AWS_S3_ENDPOINT=http://localhost:9000

# Media Storage
MEDIA_STORAGE_TYPE=local
# Options: local, s3
LOCAL_MEDIA_PATH=./uploads

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:5173,http://localhost:3001
SOCKET_PING_TIMEOUT=60000
SOCKET_PING_INTERVAL=25000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
# Options: error, warn, info, debug

# Mock Services (for development)
MOCK_POLICE_ALERTS=true
MOCK_SMS=true
MOCK_WHATSAPP=true

# Police Alert System
POLICE_API_ENDPOINT=https://police-api.example.com
POLICE_API_KEY=your-police-api-key

# Geospatial
DEFAULT_DANGER_ZONE_RADIUS=500
# Radius in meters
RED_ZONE_INACTIVITY_THRESHOLD=600
# Seconds (10 minutes)

# Background Jobs
BULL_QUEUE_REMOVE_ON_COMPLETE=true
BULL_QUEUE_REMOVE_ON_FAIL=false

# Audio Processing
AUDIO_MAX_DURATION=20
# Seconds
AUDIO_FORMAT=mp3
AUDIO_BITRATE=64k

# Video Processing
VIDEO_MAX_DURATION=60
# Seconds
VIDEO_FORMAT=mp4
VIDEO_RESOLUTION=720p

# Admin Configuration
ADMIN_EMAIL=admin@womensafety.com
ADMIN_PASSWORD=Admin@12345
# Change in production!

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
CORS_CREDENTIALS=true

# Monitoring (Optional)
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Volunteer Configuration
VOLUNTEER_MAX_DISTANCE=5000
# Maximum distance in meters to assign volunteer
VOLUNTEER_RESPONSE_TIMEOUT=300
# Seconds

# Notification Settings
PUSH_NOTIFICATION_ENABLED=true
EMAIL_NOTIFICATION_ENABLED=false

# SMTP (if email enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@womensafety.com
